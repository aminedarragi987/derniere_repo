services:
  postgres:
    image: postgres:15
    container_name: postgresdb
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: data2010.
      POSTGRES_DB: IAM
    ports:
      - "5432:5432"
    networks:
      - backend
    volumes:    
      - ./init-db:/docker-entrypoint-initdb.d 
  authapi:
    container_name: authapi
    build:
      context: .
      dockerfile: ./Auth.API/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      Jwt__Issuer: auth.api
      Jwt__Audience: AllMicroservices
      Jwt__Key: Dz65RkF0o2n023iLknkltZYz4XAMelP+mVY4le60kbY=
      Jwt__LifetimeMinutes: 15
      ConnectionStrings__DefaultConnection: "Host=postgresdb;Port=5432;Database=IAM;Username=postgres;Password=data2010."
    ports:
      - "5002:8080"
    depends_on:
      - postgres
    networks:
      - backend

  userapi:
    build:
      context: .
      dockerfile: ./User.API/Dockerfile
    container_name: userapi
    restart: always
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__DefaultConnection: Host=postgresdb;Port=5432;Database=IAM;Username=postgres;Password=data2010.
      Services__AuthService: http://authapi:8080
      Jwt__Issuer: auth.api
      Jwt__Audience: AllMicroservices
      Jwt__Key: Dz65RkF0o2n023iLknkltZYz4XAMelP+mVY4le60kbY=
    depends_on:
      - postgres
      - authapi
    ports:
      - "5101:8080"
    networks:
      - backend

  apigateway:
    build: 
      context: .
      dockerfile: ./Gateway/Dockerfile
    container_name: apigateway
    restart: always
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ReverseProxy__Clusters__authCluster__Destinations__d1__Address: http://authapi:8080/
      ReverseProxy__Clusters__usersCluster__Destinations__d1__Address: http://userapi:8080/
    ports:
      - "5100:8080"
    networks:
      - backend

networks:
  backend:
    driver: bridge

volumes:
  postgres_data: