{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "usersRoute": {
        "ClusterId": "usersCluster",
        "Match": {
          "Path": "/User/{**catch-all}"
        }
      },
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/Auth/{**catch-all}"
        }
      },
      "stockRoute": {
        "ClusterId": "stockCluster",
        "Match": {
          "Path": "/Stock/{**catch-all}"
        }
      },
      "clientRoute": {
        "ClusterId": "clientCluster",
        "Match": {
          "Path": "/Client/{**catch-all}"
        }
      },
      "commandeRoute": {
        "ClusterId": "commandeCluster",
        "Match": {
          "Path": "/Commande/{**catch-all}"
        }
      },
      "facturationRoute": {
        "ClusterId": "facturationCluster",
        "Match": {
          "Path": "/Facture/{**catch-all}"
        }
      },
      "livraisonRoute": {
        "ClusterId": "livraisonCluster",
        "Match": {
          "Path": "/Livraison/{**catch-all}"
        }
      },
      "ordersRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders" }
        ]
      }
    },
    "Clusters": {
      "usersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://userapi:8080/"
          }
        }
      },
      "authCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://authapi:8080/"
          }
        }
      },
      "stockCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://gestiondestockapi:8080/"
          }
        }
      },
      "clientCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://clientapi:8080/"
          }
        }
      },
      "commandeCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://commandeapi:8080/"
          }
        }
      },
      "facturationCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://facturationapi:8080/"
          }
        }
      },
      "livraisonCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://livraisonapi:8080/"
          }
        }
      },
      "ordersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://host.docker.internal:5001/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}